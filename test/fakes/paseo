#!/usr/bin/env node
/*
 * Stand-in for the `paseo` CLI, used by test/paseo-adapter.test.ts and the
 * command-flow tests.
 *
 * It is driven entirely by environment variables so each test can script one
 * invocation, and it records the argv it received so a test can assert that the
 * adapter passed an argument vector and never went through a command
 * interpreter: a value containing spaces, quotes or `;` must arrive as exactly
 * one element.
 *
 *   BM_FAKE_ARGV_LOG   append one JSON line per invocation
 *   BM_FAKE_PID_FILE   write this process's pid (lets a test watch it die)
 *   BM_FAKE_MODE       ok | hang | hang-ignore-term        (default: ok)
 *   BM_FAKE_STDOUT     text written to stdout in `ok` mode
 *   BM_FAKE_STDERR     text written to stderr
 *   BM_FAKE_EXIT       exit code in `ok` mode               (default: 0)
 *   BM_FAKE_TOUCH      file created on start; a test uses its ABSENCE to show
 *                      that shell metacharacters in an argument never ran
 *   BM_FAKE_SCRIPT     path to a JSON file scripting several subcommands in
 *                      one run: { "<argv[0]> <argv[1]>": { stdout, stderr,
 *                      exit } }, e.g. "daemon status", "plugin install". A
 *                      subcommand with no entry falls back to the variables
 *                      above. Only read when set, so older tests are unchanged.
 *   BM_FAKE_STATE      path to a JSON file standing in for the daemon's plugin
 *                      catalogue (bm-vey). When set, `plugin ls`, `plugin
 *                      install` and `plugin remove` are answered from it and
 *                      change it, ahead of BM_FAKE_SCRIPT, the way Paseo 0.8
 *                      behaves:
 *                        { "plugins": { "<id>": { "path", "status" } },
 *                          "status": "running",          // status of a new install
 *                          "installFailures": { "<dir>": "<reason>" } }
 *                      - install of an id that is already configured fails
 *                        with Paseo's "already configured" error, changing
 *                        nothing;
 *                      - install of a directory listed in installFailures
 *                        fails with that reason, and the entry stays
 *                        configured with status "failed" (Paseo 0.8 writes the
 *                        entry before starting the plugin and keeps it);
 *                      - remove deletes the entry, and fails when there is none.
 *                      - reload <id> (bm-i52) fails when the id is not
 *                        configured, or with the reason in
 *                        "reloadFailures": { "<id>": "<reason>" } (status
 *                        becomes "failed"). Otherwise the next `plugin ls`
 *                        calls report "reloadStatuses" one by one (default
 *                        ["running"]); the last one stays.
 *                      Failures print Paseo's JSON error document on stdout
 *                      and exit 1.
 */
const fs = require("node:fs");
const path = require("node:path");

const argv = process.argv.slice(2);

if (process.env.BM_FAKE_ARGV_LOG) {
  fs.appendFileSync(
    process.env.BM_FAKE_ARGV_LOG,
    JSON.stringify({ argv, argc: argv.length, cwd: process.cwd(), pid: process.pid }) + "\n",
  );
}

if (process.env.BM_FAKE_PID_FILE) {
  fs.writeFileSync(process.env.BM_FAKE_PID_FILE, String(process.pid));
}

if (process.env.BM_FAKE_TOUCH) {
  fs.writeFileSync(process.env.BM_FAKE_TOUCH, "the fake CLI ran\n");
}

if (process.env.BM_FAKE_STATE && argv[0] === "plugin" && ["ls", "install", "remove", "reload"].includes(argv[1])) {
  const statePath = process.env.BM_FAKE_STATE;
  const state = fs.existsSync(statePath) ? JSON.parse(fs.readFileSync(statePath, "utf8")) : {};
  state.plugins = state.plugins || {};
  const save = () => fs.writeFileSync(statePath, JSON.stringify(state, null, 2));
  const fail = (message) => {
    process.stdout.write(
      JSON.stringify({ error: { name: "DaemonRpcError", code: "handler_error", message: `Request failed: ${message}` } }) + "\n",
    );
    process.exit(1);
  };
  const summary = (id) => ({ id, path: state.plugins[id].path, enabled: true, status: state.plugins[id].status });

  if (argv[1] === "ls") {
    const pending = state.pendingStatuses || {};
    for (const [id, queue] of Object.entries(pending)) {
      if (state.plugins[id] && queue.length > 0) state.plugins[id].status = queue.shift();
    }
    if (Object.keys(pending).length > 0) save();
    process.stdout.write(JSON.stringify(Object.keys(state.plugins).map(summary)));
    process.exit(0);
  }
  if (argv[1] === "install") {
    const directory = path.resolve(argv[2]);
    const idAt = argv.indexOf("--id");
    const id = idAt >= 0 ? argv[idAt + 1] : "paseo-bm";
    if (state.plugins[id]) {
      fail(`Plugin ID "${id}" is already configured; choose another ID with --id`);
    }
    const failure = (state.installFailures || {})[directory];
    if (failure !== undefined) {
      state.plugins[id] = { path: directory, status: "failed" };
      save();
      fail(failure);
    }
    state.plugins[id] = { path: directory, status: state.status || "running" };
    save();
    process.stdout.write(JSON.stringify(summary(id)));
    process.exit(0);
  }
  if (argv[1] === "reload") {
    const id = argv[2];
    if (!state.plugins[id]) {
      fail(`Plugin "${id}" is not configured`);
    }
    const failure = (state.reloadFailures || {})[id];
    if (failure !== undefined) {
      state.plugins[id].status = "failed";
      save();
      fail(failure);
    }
    state.pendingStatuses = { ...(state.pendingStatuses || {}), [id]: [...(state.reloadStatuses || ["running"])] };
    save();
    process.stdout.write(`Plugin ${id} reloaded\n`);
    process.exit(0);
  }
  // remove
  const id = argv[2];
  if (!state.plugins[id]) {
    fail(`Plugin "${id}" is not configured`);
  }
  delete state.plugins[id];
  save();
  process.stdout.write(JSON.stringify({ id }));
  process.exit(0);
}

let scripted;
if (process.env.BM_FAKE_SCRIPT) {
  const script = JSON.parse(fs.readFileSync(process.env.BM_FAKE_SCRIPT, "utf8"));
  scripted = script[argv.slice(0, 2).join(" ")];
}

if (scripted) {
  if (scripted.stderr) process.stderr.write(scripted.stderr);
  if (scripted.stdout) process.stdout.write(scripted.stdout);
  process.exit(Number(scripted.exit || 0));
}

if (process.env.BM_FAKE_STDERR) {
  process.stderr.write(process.env.BM_FAKE_STDERR);
}

const mode = process.env.BM_FAKE_MODE || "ok";

if (mode === "hang" || mode === "hang-ignore-term") {
  if (mode === "hang-ignore-term") {
    // Refuse the polite request, so only an outright kill ends this process.
    process.on("SIGTERM", () => {});
    process.on("SIGINT", () => {});
  }
  // Stay alive without burning CPU; the adapter's deadline must end this.
  setInterval(() => {}, 1000);
  return;
}

if (process.env.BM_FAKE_STDOUT) {
  process.stdout.write(process.env.BM_FAKE_STDOUT);
}

process.exit(Number(process.env.BM_FAKE_EXIT || "0"));
