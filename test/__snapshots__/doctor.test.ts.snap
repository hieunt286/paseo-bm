      "remediation": ""
    },
    {
      "id": "skills-agents",
      "severity": "ok",
      "message": "shared agent home: not installed (<HOME>/.agents does not exist), skipped",
      "remediation": ""
    },
    {
      "id": "skills-claude",
      "severity": "ok",
      "message": "Claude Code: all 5 required skills are installed in <HOME>/.claude/skills",
      "remediation": ""
    },
    {
      "id": "skills-codex",
