      "message": "The \`bm-worker\` role is configured as codex/gpt-5.6-sol (Paseo tools: yes).",
      "remediation": ""
    },
    {
      "id": "role-bm-reviewer",
      "severity": "error",
      "message": "The \`bm-reviewer\` role is recorded but Paseo's configuration is missing agents.providers.bm-reviewer and daemon.agentProfiles[bm-reviewer].",
      "remediation": "Run \`npx paseo-bm install --apply\` to put it back. Nothing is changed by \`doctor\`."
    },
    {
      "id": "payload-versions",
      "severity": "ok",
      "message": "1 payload version is kept (active: 0.0.9).",
      "remediation": ""
    },
    {
      "id": "backups",
