exports[`runDoctor — an install that has drifted > renders the JSON document of Design §4.4 1`] = `
"{
  "schemaVersion": 1,
  "command": "doctor",
  "mode": "preview",
  "paseoBmVersion": "0.1.0",
  "paseo": {
    "cliVersion": "0.8.0",
    "daemonVersion": "0.8.0",
    "home": "/fake/paseo",
    "pluginsEnabled": false
  },
  "checks": [
    {
      "id": "paseo-daemon",
      "severity": "ok",
      "message": "The Paseo daemon answered (daemon 0.8.0).",
      "remediation": ""
    },
    {
      "id": "paseo-version",
      "severity": "ok",
      "message": "Paseo 0.8.0 is supported, and the CLI and daemon agree.",
      "remediation": ""
    },
    {
      "id": "install-record",
      "severity": "ok",
      "message": "The install record at <HOME>/.paseo-bm/install.json is readable.",
      "remediation": ""
    },
    {
      "id": "install-version",
      "severity": "error",
      "message": "The installed payload is version 0.0.9, but this paseo-bm is 0.1.0.",
      "remediation": "Run \`npx paseo-bm install --apply\` to install the current payload. Earlier versions are kept; only \`--prune\` removes them."
    },
    {
      "id": "files-missing",
      "severity": "error",
      "message": "1 recorded file is gone: plugin/0.0.9/index.server.js.",
      "remediation": "Run \`npx paseo-bm install --apply\` to put it back. Nothing is changed by \`doctor\`."
    },
    {
      "id": "files-modified",
      "severity": "error",
      "message": "1 recorded file no longer matches the hash paseo-bm wrote: plugin/0.0.9/roles/worker.md.",
      "remediation": "Keep your edits, or run \`npx paseo-bm install --apply --force\` to restore the shipped copy. A backup is always taken before overwriting."
    },
    {
      "id": "plugin-registered",
      "severity": "ok",
      "message": "Paseo lists the plugin \`paseo-bm\`.",
      "remediation": ""
    },
    {
      "id": "plugin-status",
      "severity": "error",
      "message": "Paseo reports the plugin \`paseo-bm\` with status \`disabled\`, not running.",
      "remediation": "Run \`npx paseo-bm install --apply --enable-plugins\` to consent to both halves of that trust boundary: enabling plugins and granting Paseo tools to agents."
    },
    {
      "id": "plugins-enabled",
      "severity": "error",
      "message": "Paseo's plugin switch (\`pluginsEnabled\`) is off, so the installed plugin does nothing.",
      "remediation": "Run \`npx paseo-bm install --apply --enable-plugins\` to consent to both halves of that trust boundary: enabling plugins and granting Paseo tools to agents."
    },
    {
      "id": "agent-tools",
      "severity": "error",
      "message": "Paseo's agent tool switch (\`daemon.mcp.injectIntoAgents\`) is off, so Beads Manager cannot create Beads Worker.",
      "remediation": "Run \`npx paseo-bm install --apply --enable-plugins\` to consent to both halves of that trust boundary: enabling plugins and granting Paseo tools to agents."
    },
    {
      "id": "role-bm-manager",
      "severity": "ok",
      "message": "The \`bm-manager\` role is configured as claude/claude-opus-5 (Paseo tools: yes).",
      "remediation": ""
    },
    {
      "id": "role-bm-worker",
