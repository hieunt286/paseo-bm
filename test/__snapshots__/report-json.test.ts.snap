      "model": "gpt-5.6-sol",
      "paseoTools": true,
      "loggedIn": false
    },
    {
      "role": "reviewer",
      "provider": "codex",
      "model": "gpt-5.6-sol",
      "paseoTools": false,
      "loggedIn": null
