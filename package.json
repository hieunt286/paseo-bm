{
  "name": "paseo-bm",
  "version": "0.4.0-alpha.0",
  "description": "Beads Management for Paseo: the last version of the paseo-bm command, which moves an install made by an earlier npx paseo-bm to the plugin on npm. The product itself is the paseo-bm-plugin package.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "paseo-bm": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hieunt286/paseo-bm.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run generate:plugin-version && npm run generate:role-instructions && tsup",
    "verify": "npm run typecheck && npm run typecheck:plugin && npm run lint && npm run test && npm run build",
    "prepack": "npm run build",
    "generate:plugin-version": "node scripts/generate-plugin-version.mjs",
    "generate:role-instructions": "node scripts/generate-role-instructions.mjs",
    "typecheck:plugin": "tsc -p plugin/tsconfig.json",
    "smoke:packed": "node scripts/smoke-packed.mjs",
    "measure": "node scripts/measure-requests.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@getpaseo/plugin": "0.8.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.7.0",
    "@types/react": "~19.2.0",
    "eslint": "^9.12.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0",
    "zod": "^4.4.3"
  }
}
