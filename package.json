{
  "name": "paseo-bm",
  "private": true,
  "version": "0.5.0",
  "description": "Beads Management for Paseo: the development root of paseo-bm-plugin, the plugin in plugin/. Private, never published; it holds the version the build writes into the plugin.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hieunt286/paseo-bm.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project default",
    "test:bench": "vitest run --project bench",
    "test:eval": "vitest run --project eval",
    "build": "npm run generate:plugin-version && npm run generate:role-instructions",
    "verify": "npm run typecheck && npm run typecheck:plugin && npm run lint && npm run test && npm run test:bench && npm run test:eval && npm run build",
    "generate:plugin-version": "node scripts/generate-plugin-version.mjs",
    "generate:role-instructions": "node scripts/generate-role-instructions.mjs",
    "typecheck:plugin": "tsc -p plugin/tsconfig.json",
    "smoke:packed": "node scripts/smoke-packed.mjs",
    "eval:replay": "tsup --config tsup.eval.config.ts && node .eval-dist/replay.js",
    "eval:suite": "tsup --config tsup.eval.config.ts && node .eval-dist/suite.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@getpaseo/plugin": "0.8.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.7.0",
    "@types/react": "~19.2.0",
    "eslint": "^9.12.0",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0",
    "zod": "^4.4.3"
  }
}
